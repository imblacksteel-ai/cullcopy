    "yyyy=年  yy=年(2桁)  MM=月  dd=日　/ で区切るとサブフォルダ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "yyyy=year  yy=year (2 digits)  MM=month  dd=day   Use / to create subfolders"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "yyyy=年  yy=年(2桁)  MM=月  dd=日　/ で区切るとサブフォルダ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "yyyy=연도  yy=연도(2자리)  MM=월  dd=일   /로 구분하면 하위 폴더"
          }
        },
        "zh-Hans": {
